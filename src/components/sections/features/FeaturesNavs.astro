---
// Import the necessary dependencies
import TabNav from '@components/ui/blocks/TabNav.astro';
import TabContent from '@components/ui/blocks/TabContent.astro';
import Icon from '@components/ui/icons/Icon.astro';

// Define props
const { title, tabs } = Astro.props;
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
  <div class="relative p-6 md:p-16">
    <div class="relative z-10 lg:grid lg:grid-cols-12 lg:items-center lg:gap-16">

      <!-- LEFT CONTENT -->
      <div class="mb-10 lg:order-2 lg:col-span-6 lg:col-start-8 lg:mb-0">
        <h2 class="text-2xl font-bold text-neutral-800 sm:text-3xl dark:text-neutral-200">
          <Fragment set:html={title} />
        </h2>

        <nav class="mt-5 grid gap-4 md:mt-10" role="tablist">
          {
           tabs.map((tab: any, index: number) => (
              <TabNav
                id={`tabs-with-card-item-${index + 1}`}
                dataTab={`#tabs-with-card-${index + 1}`}
                aria={`tabs-with-card-${index + 1}`}
                heading={tab.heading}
                content={tab.content}
                first={tab.first}
              >
                <Icon name={tab.svg} />
              </TabNav>
            ))
          }
        </nav>
      </div>

      <!-- RIGHT IMAGE -->
      <div class="lg:col-span-6">
        {
          tabs.map((tab: any, index: number) => (
            <TabContent
              id={`tabs-with-card-${index + 1}`}
              aria={`tabs-with-card-item-${index + 1}`}
              src={tab.src}
              alt={tab.alt}
              first={tab.first}
              second={tab.second}
            />
          ))
        }
      </div>

    </div>
  </div>
</section>