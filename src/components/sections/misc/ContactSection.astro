---
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';

const title = 'Contact STINDICO';
const subTitle =
  'Get in touch with us for Biomass Briquettes, Silica Sand, Quartz Products and Industrial Supply Solutions.';

const formTitle = 'Send us an Inquiry';
const formSubTitle = "We'll get back to you within 24 hours.";
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-4xl">

    <div class="text-center">
      <h1
        class="text-3xl font-bold text-neutral-800 dark:text-neutral-200"
      >
        {title}
      </h1>

      <p
        class="mt-3 text-neutral-600 dark:text-neutral-400"
      >
        {subTitle}
      </p>
    </div>

    <div
      class="mt-12 rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-700 dark:bg-neutral-900 lg:p-10"
    >
      <h2
        class="mb-8 text-2xl font-bold text-neutral-800 dark:text-neutral-200"
      >
        {formTitle}
      </h2>

      <form>
        <div class="grid gap-4">

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <TextInput
              id="firstname"
              label="First Name"
              name="firstname"
            />

            <TextInput
              id="lastname"
              label="Last Name"
              name="lastname"
            />
          </div>

          <EmailContactInput id="email" />

          <PhoneInput id="phone" />

          <TextAreaInput
            id="details"
            label="Details"
            name="details"
          />

        </div>

        <div class="mt-6">
          <AuthBtn title="Send Message" />
        </div>

        <div class="mt-4 text-center">
          <p class="text-sm text-neutral-600 dark:text-neutral-400">
            {formSubTitle}
          </p>
        </div>
      </form>

    </div>

  </div>
</section>