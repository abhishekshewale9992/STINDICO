---
import MainLayout from '@/layouts/MainLayout.astro';
import ContactSection from '@components/sections/misc/ContactSection.astro';

const pageTitle = 'Contact | STINDICO';

const metaDescription =
  'Contact STINDICO for Biomass Briquettes, Silica Sand, Quartz Products and Industrial Supply Solutions.';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle="Contact Us | STINDICO"
>

  <!-- Contact Form -->
  <ContactSection />

  <!-- Office Address Section -->
  <section class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8">

    <div
      class="rounded-3xl border border-neutral-200 bg-white p-8 shadow-sm dark:border-neutral-700 dark:bg-neutral-900"
    >

      <h2
        class="mb-8 text-3xl font-bold text-neutral-800 dark:text-neutral-200"
      >
        STINDICO Office Address
      </h2>

      <div class="grid gap-10 lg:grid-cols-2">

        <!-- Left Side -->
        <div>

          <h3
            class="mb-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200"
          >
            Address
          </h3>

          <p
            class="leading-8 text-neutral-600 dark:text-neutral-400"
          >
            Plot No. 12, Dhairya Akash Residency<br />
            Morewadi<br />
            Kolhapur, Maharashtra<br />
            Karvir Subdistrict<br />
            Kolhapur District<br />
            416013
          </p>

          <div class="mt-8">

            <h3
              class="text-xl font-semibold text-neutral-800 dark:text-neutral-200"
            >
              Phone Number
            </h3>

            <a
              href="tel:+919158616699"
              class="mt-2 block text-lg font-medium text-orange-600 hover:underline"
            >
              +91 9158616699
            </a>

          </div>

          <div class="mt-8">

            <h3
              class="text-xl font-semibold text-neutral-800 dark:text-neutral-200"
            >
              Email Address
            </h3>

            <a
              href="mailto:info@stindico.com"
              class="mt-2 block text-lg text-neutral-600 hover:underline dark:text-neutral-400"
            >
              info@stindico.com
            </a>

          </div>

        </div>

        <!-- Right Side Google Map -->
        <div>

          <h3
            class="mb-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200"
          >
            Our Location
          </h3>

          <iframe
            src="https://maps.google.com/maps?q=Kolhapur&t=&z=13&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="400"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="rounded-2xl shadow"
          >
          </iframe>

        </div>

      </div>

    </div>

  </section>

</MainLayout>