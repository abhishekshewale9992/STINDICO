---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import ContactSection from '@components/sections/misc/ContactSection.astro';

import { SITE } from '@data/constants';

const pageTitle: string = `Contact | STINDICO`;

const metaDescription =
  'Contact STINDICO for Biomass Briquettes, Silica Sand, Quartz products, industrial machines, and bulk industrial raw material supply solutions.';

const ogTitle = 'Contact Us | STINDICO';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}

  structuredData={{
    '@context': 'https://schema.org',

    '@type': 'WebPage',

    '@id': 'https://stindico.com/contact',

    url: 'https://stindico.com/contact',

    name: 'Contact Us | STINDICO',

    description:
      'Contact STINDICO for high-quality industrial raw materials including Biomass Briquettes, Silica Sand, Quartz products, and industrial machines.',

    isPartOf: {
      '@type': 'WebSite',

      url: 'https://stindico.com',

      name: 'STINDICO',

      description:
        'STINDICO supplies premium industrial raw materials and industrial machinery solutions.',
    },

    inLanguage: 'en-US',
  }}
>

  <!-- Existing Contact Section -->
  <ContactSection />

  <!-- Address & Contact Info -->
  <section
    class="mx-auto max-w-[85rem] px-4 pb-16 sm:px-6 lg:px-8"
  >

    <div
      class="mt-10 grid gap-8 rounded-3xl border border-neutral-200 bg-white p-8 shadow-sm dark:border-neutral-700 dark:bg-neutral-900 lg:grid-cols-2"
    >

      <!-- Left Side -->
      <div>

        <h2
          class="text-3xl font-bold text-neutral-800 dark:text-neutral-200"
        >
          STINDICO Office Address
        </h2>

        <div
          class="mt-8 space-y-6"
        >

          <!-- Address -->
          <div>

            <h3
              class="text-xl font-semibold text-neutral-800 dark:text-neutral-200"
            >
              Address
            </h3>

            <p
              class="mt-3 text-lg leading-8 text-neutral-600 dark:text-neutral-400"
            >
              Plot no -12 dhairya akash residency
              <br />
              morewadi Kolhapur,
              <br />
              Karvir Subdistrict,
              <br />
              Kolhapur District,
              <br />
              416013
            </p>

          </div>

          <!-- Phone -->
          <div>

            <h3
              class="text-xl font-semibold text-neutral-800 dark:text-neutral-200"
            >
              Phone Number
            </h3>

            <p
              class="mt-2 text-lg font-medium text-orange-600"
            >
              +91 9146818645
            </p>

          </div>

          <!-- Email -->
          <div>

            <h3
              class="text-xl font-semibold text-neutral-800 dark:text-neutral-200"
            >
              Email Address
            </h3>

            <p
              class="mt-2 text-lg text-neutral-600 dark:text-neutral-400"
            >
              info@stindico.com
            </p>

          </div>

        </div>

      </div>

      <!-- Right Side -->
      <div
        class="rounded-2xl bg-neutral-100 p-8 dark:bg-neutral-800"
      >

        <h3
          class="text-2xl font-bold text-neutral-800 dark:text-neutral-200"
        >
          Industrial Supply Solutions
        </h3>

        <p
          class="mt-4 text-neutral-600 dark:text-neutral-400"
        >
          STINDICO supplies high-quality industrial raw materials and heavy machinery solutions for multiple industries across India.
        </p>

        <div
          class="mt-8 space-y-4 text-neutral-700 dark:text-neutral-300"
        >

          <div
            class="rounded-xl bg-white p-4 shadow-sm dark:bg-neutral-900"
          >
            ✔ Biomass Briquettes
          </div>

          <div
            class="rounded-xl bg-white p-4 shadow-sm dark:bg-neutral-900"
          >
            ✔ Silica Sand (97%–99%)
          </div>

          <div
            class="rounded-xl bg-white p-4 shadow-sm dark:bg-neutral-900"
          >
            ✔ Quartz Products
          </div>

          <div
            class="rounded-xl bg-white p-4 shadow-sm dark:bg-neutral-900"
          >
            ✔ Industrial Machines
          </div>

          <div
            class="rounded-xl bg-white p-4 shadow-sm dark:bg-neutral-900"
          >
            ✔ Bulk Industrial Supply
          </div>

        </div>

        <div
          class="mt-8 flex flex-wrap gap-4"
        >

          <a
            href="tel:+919146818645"
            class="inline-flex items-center rounded-lg bg-orange-600 px-6 py-3 text-white hover:bg-orange-700"
          >
            Call Now
          </a>

          <a
            href="/products"
            class="inline-flex items-center rounded-lg border border-neutral-300 px-6 py-3 text-neutral-700 hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800"
          >
            View Products
          </a>

        </div>

      </div>

    </div>

  </section>

</MainLayout>