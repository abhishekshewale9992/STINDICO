---
// Import necessary components, modules and types
import MainLayout from '@/layouts/MainLayout.astro';
import CardBlog from '@components/ui/cards/CardBlog.astro';
import CardBlogRecent from '@components/ui/cards/CardBlogRecent.astro';
import CardInsight from '@components/ui/cards/CardInsight.astro';

import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import { SITE } from '@data/constants';

// Get all blog posts
const englishBlogEntries = await getCollection('blog', ({ id }) => {
  return id.startsWith('en/');
});

// Get all insight posts
const englishInsightsEntries = await getCollection('insights', ({ id }) => {
  return id.startsWith('en/');
});

// Sort blog posts
const blogPosts: CollectionEntry<'blog'>[] = englishBlogEntries.sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Insights posts
const insightPosts: CollectionEntry<'insights'>[] = englishInsightsEntries;

// Most recent post
const mostRecentPost: CollectionEntry<'blog'> = blogPosts[0];

// Other blog posts
const otherPosts: CollectionEntry<'blog'>[] = blogPosts.slice(1);

// Page content
const title: string = 'Industrial Insights & Raw Material Updates';

const subTitle: string =
  'Explore the latest industrial trends, silica sand applications, biomass briquettes solutions, quartz products, and industrial supply chain updates from STINDICO.';

const secondTitle: string = 'Industrial Knowledge Hub';

const secondSubTitle: string =
  'Stay updated with industrial raw material solutions, sustainable fuel technologies, mining equipment updates, and bulk industrial supply trends.';

// SEO
const pageTitle: string = `Blog | STINDICO`;

const metaDescription =
  'Read the latest industrial raw material insights, silica sand updates, biomass briquettes trends, quartz product news, and industrial supply chain articles from STINDICO.';

const ogTitle = 'Industrial Raw Materials Blog | STINDICO';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}

  structuredData={{
    '@context': 'https://schema.org',

    '@type': 'WebPage',

    '@id': 'https://stindico.com/blog',

    url: 'https://stindico.com/blog',

    name: 'Blog | STINDICO',

    description:
      'Industrial insights and updates from STINDICO covering Biomass Briquettes, Silica Sand, Quartz Products, industrial machines, and bulk supply solutions.',

    isPartOf: {
      '@type': 'WebSite',

      url: 'https://stindico.com',

      name: 'STINDICO',

      description:
        'STINDICO supplies industrial raw materials and industrial machinery solutions across India.',
    },

    inLanguage: 'en-US',
  }}
>

  <!-- Hero Section -->
  <section
    class="mx-auto max-w-[85rem] px-4 pt-16 sm:px-6 lg:px-8 lg:pt-20"
  >

    <div class="grid items-center gap-12 lg:grid-cols-2">

      <!-- Left Content -->
      <div>

        <h1
          class="text-4xl font-bold tracking-tight text-neutral-800 md:text-5xl lg:text-6xl dark:text-neutral-200"
        >
          {title}
        </h1>

        <p
          class="mt-6 text-lg text-neutral-600 dark:text-neutral-400"
        >
          {subTitle}
        </p>

        <div class="mt-8 flex gap-4">

          <a
            href="/products"
            class="inline-flex items-center rounded-lg bg-orange-600 px-6 py-3 text-white hover:bg-orange-700"
          >
            Explore Products
          </a>

          <a
            href="/contact"
            class="inline-flex items-center rounded-lg border border-neutral-300 px-6 py-3 text-neutral-700 hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800"
          >
            Contact Team
          </a>

        </div>

      </div>

      <!-- Right Images -->
      <div class="grid grid-cols-2 gap-4">

        <img
          src="/silica-sand.jpeg"
          alt="Silica Sand"
          class="h-64 w-full rounded-2xl object-cover shadow-lg"
        />

        <img
          src="/quartz.jpeg"
          alt="Quartz Products"
          class="h-64 w-full rounded-2xl object-cover shadow-lg"
        />

        <img
          src="/Biomass.png"
          alt="Biomass Briquettes"
          class="col-span-2 h-72 w-full rounded-2xl object-cover shadow-lg"
        />

      </div>

    </div>

  </section>

  {/*
<!-- Blog Grid -->
<section
  class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8"
>
  ...
</section>

<!-- Featured Blog -->
<section
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8"
>
  ...
</section>

<!-- Insights Section -->
<section
  class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8"
>
  ...
</section>
*/}



</MainLayout>