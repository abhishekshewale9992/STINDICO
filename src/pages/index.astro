---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import TestimonialsSection from '@components/sections/testimonials/TestimonialsSection.astro';
import PricingSection from '@components/sections/pricing/PricingSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import AnnouncementBanner from '@components/ui/banners/AnnouncementBanner.astro';
import heroImage from "../images/full-image.jpeg";
import faqs from '@data/faqs.json';
import features from '@data/features.json';
import pricing from '@data/pricing.json';

import construction from '@images/construction-image.avif';
import tools from '@images/automated-tools.avif';
import dashboard from '@images/dashboard-image.avif';
import { partnersData } from '@/data_files/constants';

const avatarSrcs: Array<string> = [
  '/avatar.png',
  '/avatar.png',
  '/avatar.png',
  '/avatar.png',
];
---

<MainLayout>
  <AnnouncementBanner
  btnId="dismiss-button"
  btnTitle="Chat on WhatsApp for Bulk Orders"
  url="https://wa.me/9158616699"
/>

 <HeroSection
  title={`High-Quality Industrial Materials <span class="text-yellow-500 dark:text-yellow-400">Supplier</span>`}
  subTitle="We deal in a wide range of products across industries, providing reliable supply chain solutions for both domestic and international markets."
  primaryBtn="Start Exploring"
  primaryBtnURL="/products"
  secondaryBtn="Contact Sales Team"
  secondaryBtnURL="/contact"
  withReview={false}
  avatars={avatarSrcs}
  rating={`<span class="font-bold">4.8</span> / 5`}
  starCount={4}
  reviews={`From Over <span class="font-bold">12.8k</span> Reviews`}
  src={heroImage}
  alt="Industrial materials display"
/>
{/*
<ClientsSection
  title="Trusted by Industrial Buyers Across India"
  subTitle="Experience the reliability chosen by industry giants."
  partners={partnersData}
/>
*/}

  <FeaturesGeneral
  title="Meeting Industrial Material Demands"
  subTitle="We at STINDICO specialize in supplying high-quality industrial raw materials including Biomass Briquettes, Silica Sand, and Quartz.
Our focus is to deliver consistent quality, reliable bulk supply, and cost-effective solutions for industries like ceramics, glass, foundry, construction, and energy sectors."
  src="/product-image-index.jpeg"
  alt="Industrial materials"
  features={features}
/>

 <FeaturesNavs
  title={`Industrial Solutions by <span class="text-yellow-500 dark:text-yellow-400">STINDICO</span> tailored for your business needs.`}
  tabs={[
    {
  heading: 'Biomass Briquettes',
  content:
    "High-quality biomass briquettes designed for industrial fuel applications. With high calorific value, low moisture, and eco-friendly combustion, they are ideal for boilers, furnaces, and thermal applications.",
  svg: 'tools',
  src: "/Biomass.png",   // ✅ YOUR IMAGE ADDED
  alt: 'Biomass briquettes used as industrial fuel',
  first: true,
},
    {
  heading: 'Silica Sand (97%–99%)',
  content:
    "We supply premium-grade silica sand with controlled purity levels suitable for glass manufacturing, ceramics, foundry, and construction industries. Available in multiple grades and sizes.",
  svg: 'dashboard',
  src: "/silica-sand.jpeg",   // ✅ EXACT SAME NAME
  alt: 'Silica sand for industrial use',
  second: true,
},
    {
      heading: 'Quartz Products',
      content:
        "High-quality quartz available in lumps, powder, and grits. Known for durability, high silica content, and wide industrial applications including glass, ceramics, and engineered stone.",
      svg: 'house',
      src: "/quartz.jpeg",   // ✅ YOUR IMAGE (IMPORTANT)
      alt: 'Quartz materials for industrial applications',
    },
  ]}
/>

  <TestimonialsSection
  title="Trusted by Industrial Clients"
  subTitle="STINDICO is a reliable partner for industries requiring consistent quality, bulk supply, and cost-effective raw materials solutions."

  testimonials={[
  {
    content:
      'We have been sourcing silica sand from STINDICO, and the quality consistency is excellent. Their timely delivery helps us maintain smooth production operations.',
    author: 'Rahul Sharma',
    role: 'Procurement Manager | Ceramic Industry',
    avatarSrc: '/Biomass.png',
  },
  {
    content:
      'STINDICO’s biomass briquettes helped us reduce fuel costs significantly while maintaining high efficiency in our boilers. Highly recommended supplier.',
    author: 'Amit Verma',
    role: 'Operations Head | Food Processing Unit',
    avatarSrc: '/Biomass.png',
  },
]}

  statistics={[
    {
      count: '500+',
      description:
        'industrial clients served across multiple sectors',
    },
    {
      count: '99%',
      description:
        'on-time delivery with consistent bulk supply',
    },
    {
      count: '3800+',
      description:
        'kcal/kg average calorific value of biomass briquettes',
    },
    {
      count: '3+',
      description: 'core product categories supplied (Briquettes, Silica, Quartz)',
    },
  ]}
/>
  {/*
<PricingSection pricing={pricing} />
*/}

  <FAQ title="Frequently<br />asked questions" faqs={faqs} />

  
</MainLayout>
