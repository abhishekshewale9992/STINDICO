---
// Import necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import LeftSection from '@components/ui/blocks/LeftSection.astro';
import RightSection from '@components/ui/blocks/RightSection.astro';
import FeaturesStats from '@components/sections/features/FeaturesStats.astro';

// Import your images from public folder
import silicaSand from '../../public/silica-sand.jpeg';
import quartzImg from '../../public/quartz.jpeg';
import biomassImg from '../../public/Biomass.png';

import { SITE } from '@data/constants';

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,

    title: 'Biomass Briquettes Supply',

    subTitle:
      'STINDICO supplies premium-quality biomass briquettes with high calorific value, low moisture, and eco-friendly combustion suitable for industrial boilers and furnaces.',

    single: false,

    imgOne: biomassImg,
    imgOneAlt: 'Biomass Briquettes',

    imgTwo: silicaSand,
    imgTwoAlt: 'Industrial Silica Sand',
  },

  {
    isRightSection: false,

    title: 'Premium Silica Sand',

    subTitle:
      'We provide high-purity silica sand (97%–99%) suitable for ceramics, glass manufacturing, foundry, and construction industries with reliable bulk supply.',

    img: silicaSand,
    imgAlt: 'Silica Sand',

    btnExists: true,
    btnTitle: 'Explore Products',
    btnURL: '/products',
  },

  {
    isRightSection: true,

    title: 'Quartz Products',

    subTitle:
      'Our quartz products are available in lumps, powder, and grits with excellent purity and durability for industrial applications including engineered stone and ceramics.',

    single: false,

    imgOne: quartzImg,
    imgOneAlt: 'Quartz Products',

    imgTwo: biomassImg,
    imgTwoAlt: 'Biomass Fuel',
  },

  {
    isRightSection: false,

    title: 'Industrial Raw Material Solutions',

    subTitle:
      'STINDICO focuses on reliable supply chain management, strict quality assurance, and cost-effective industrial raw material solutions across India.',

    img: quartzImg,
    imgAlt: 'Industrial Quartz',

    btnExists: true,
    btnTitle: 'Contact Sales Team',
    btnURL: '/contact',
  },

  {
    isRightSection: true,

    title: 'Eco-Friendly Industrial Fuel',

    subTitle:
      'Our biomass briquettes help industries reduce fuel costs and carbon emissions while maintaining high thermal efficiency and operational performance.',

    single: false,

    imgOne: biomassImg,
    imgOneAlt: 'Eco-Friendly Biomass Briquettes',

    imgTwo: quartzImg,
    imgTwoAlt: 'Quartz Raw Material',

    btnExists: true,
    btnTitle: 'Get Bulk Quote',
    btnURL: '/contact',
  },
];

const pageTitle: string = `Services | STINDICO`;

const metaDescription =
  'STINDICO supplies Biomass Briquettes, Silica Sand, Quartz Products, and industrial raw materials with reliable bulk supply across India.';

const ogTitle = 'Industrial Raw Materials Supplier | STINDICO';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}

  structuredData={{
    '@context': 'https://schema.org',

    '@type': 'WebPage',

    '@id': 'https://stindico.com/services',

    url: 'https://stindico.com/services',

    name: 'Industrial Raw Materials Supplier | STINDICO',

    description:
      'STINDICO provides industrial raw materials including Biomass Briquettes, Silica Sand, and Quartz products with reliable bulk supply.',

    isPartOf: {
      '@type': 'WebSite',

      url: 'https://stindico.com',

      name: 'STINDICO',

      description:
        'STINDICO supplies industrial raw materials and industrial solutions across India.',
    },

    inLanguage: 'en-US',
  }}
>

  <!-- Hero Section -->
  <MainSection
    title="Industrial Raw Materials & Bulk Supply Solutions"

    subTitle="STINDICO provides high-quality Biomass Briquettes, Silica Sand, Quartz Products, and industrial raw materials for industries including ceramics, foundry, construction, mining, and energy sectors."

    btnExists={true}

    btnTitle="Contact Sales Team"

    btnURL="/contact"
  />

  <!-- Services Sections -->
  {
    articles.map(article => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}

          single={article.single}

          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}

          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}

          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}

          img={article.img}
          imgAlt={article.imgAlt}

          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }

  <!-- Stats Section -->
  <FeaturesStats
    title="Trusted Industrial Supply Partner"

    subTitle="STINDICO focuses on consistent quality, reliable logistics, and cost-effective industrial raw material solutions for businesses across India."

    mainStatTitle="500+"

    mainStatSubTitle="industrial clients served across multiple sectors"

    stats={[
      {
        stat: '99%',
        description: 'on-time delivery performance',
      },

      {
        stat: '3800+',
        description: 'kcal/kg biomass briquette calorific value',
      },

      {
        stat: '3+',
        description: 'core industrial raw material categories',
      },
    ]}
  />

</MainLayout>